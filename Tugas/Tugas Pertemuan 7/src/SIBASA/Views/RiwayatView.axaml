<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:SIBASA.Controls"
             xmlns:vm="using:SIBASA.ViewModels"
             xmlns:m="using:SIBASA.Models"
             x:Class="SIBASA.Views.RiwayatView"
             x:DataType="vm:RiwayatViewModel">
    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ================= Filter ================= -->
        <Border Classes="card" Padding="18,16">
            <StackPanel Spacing="12">
                <WrapPanel>
                    <StackPanel Margin="0,0,12,4">
                        <TextBlock Classes="label" Text="Dari tanggal" />
                        <CalendarDatePicker SelectedDate="{Binding Dari}" Width="160"
                                            SelectedDateFormat="Custom" CustomDateFormatString="dd MMM yyyy" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,4">
                        <TextBlock Classes="label" Text="Sampai tanggal" />
                        <CalendarDatePicker SelectedDate="{Binding Sampai}" Width="160"
                                            SelectedDateFormat="Custom" CustomDateFormatString="dd MMM yyyy" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,4">
                        <TextBlock Classes="label" Text="Jenis" />
                        <ComboBox Width="150" ItemsSource="{Binding JenisOptions}" SelectedItem="{Binding SelectedJenis}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,4">
                        <TextBlock Classes="label" Text="Cari" />
                        <TextBox Width="250" Text="{Binding KataKunci}" Watermark="Nama, no. rekening, atau no. transaksi">
                            <TextBox.InnerLeftContent>
                                <PathIcon Data="{StaticResource Icon.Search}" Width="16" Height="16" Margin="10,0,0,0"
                                          Foreground="{DynamicResource TextMutedBrush}" />
                            </TextBox.InnerLeftContent>
                        </TextBox>
                    </StackPanel>
                    <CheckBox Content="Tampilkan yang dibatalkan" IsChecked="{Binding TampilkanBatal}"
                              VerticalAlignment="Bottom" Margin="0,0,0,8" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Periode cepat:" Classes="muted" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <c:SafeButton Classes="secondary" Padding="10,4" MinHeight="30" Content="Hari ini"
                            Command="{Binding PilihPeriodeCommand}" CommandParameter="hari" />
                    <c:SafeButton Classes="secondary" Padding="10,4" MinHeight="30" Content="7 hari"
                            Command="{Binding PilihPeriodeCommand}" CommandParameter="7hari" />
                    <c:SafeButton Classes="secondary" Padding="10,4" MinHeight="30" Content="30 hari"
                            Command="{Binding PilihPeriodeCommand}" CommandParameter="30hari" />
                    <c:SafeButton Classes="secondary" Padding="10,4" MinHeight="30" Content="Bulan ini"
                            Command="{Binding PilihPeriodeCommand}" CommandParameter="bulan" />
                    <c:SafeButton Classes="secondary" Padding="10,4" MinHeight="30" Content="Tahun ini"
                            Command="{Binding PilihPeriodeCommand}" CommandParameter="tahun" />
                    <c:SafeButton Classes="ghost" Padding="10,4" MinHeight="30" Command="{Binding ResetFilterCommand}" AutomationProperties.Name="Reset filter">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.Filter}" Width="14" Height="14" />
                            <TextBlock Text="Reset filter" FontSize="13" />
                        </StackPanel>
                    </c:SafeButton>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ================= Ringkasan (hanya transaksi berhasil) ================= -->
        <Grid Grid.Row="1" ColumnDefinitions="*,14,*,14,*,14,*" Margin="0,16">
            <Border Classes="card" Padding="16,14">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Classes="iconCircle"><PathIcon Data="{StaticResource Icon.Receipt}" /></Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Transaksi berhasil" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding JumlahText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2" Classes="card" Padding="16,14">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Classes="iconCircle success"><PathIcon Data="{StaticResource Icon.Weight}" /></Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Berat disetor" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding TotalKgText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="4" Classes="card" Padding="16,14">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Classes="iconCircle success"><PathIcon Data="{StaticResource Icon.CashPlus}" /></Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Total setoran" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding TotalSetoranText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="6" Classes="card" Padding="16,14">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Classes="iconCircle warning"><PathIcon Data="{StaticResource Icon.CashMinus}" /></Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Total penarikan" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding TotalPenarikanText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= Tabel riwayat ================= -->
        <Border Grid.Row="2" Classes="card" Padding="0">
            <Grid RowDefinitions="Auto,*">
                <Grid Margin="18,14" ColumnDefinitions="*,Auto">
                    <TextBlock Classes="muted" Text="{Binding ResultText}" VerticalAlignment="Center" />
                    <c:SafeButton Grid.Column="1" Classes="dangerOutline" IsVisible="{Binding IsAdmin}"
                            Command="{Binding BatalkanCommand}" ToolTip.Tip="Pilih transaksi di tabel, lalu klik untuk membatalkan" AutomationProperties.Name="Batalkan transaksi">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource Icon.Cancel}" />
                            <TextBlock Text="Batalkan transaksi" />
                        </StackPanel>
                    </c:SafeButton>
                </Grid>
                <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                    <Panel>
                        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" RowHeight="54">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Transaksi" Width="175" SortMemberPath="Tanggal">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="m:RiwayatTransaksi">
                                            <StackPanel Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding NoTransaksi}" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="{Binding TanggalText}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Jenis" Width="118" SortMemberPath="JenisText">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="m:RiwayatTransaksi">
                                            <Border Classes="badge" Classes.success="{Binding IsSetoran}" Classes.warning="{Binding !IsSetoran}" Margin="12,0">
                                                <TextBlock Text="{Binding JenisText}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Nasabah" Width="*" MinWidth="120" SortMemberPath="NamaNasabah">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="m:RiwayatTransaksi">
                                            <StackPanel Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding NamaNasabah}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding NoRekening}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Rincian" Width="1.6*" MinWidth="150" SortMemberPath="Rincian">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="m:RiwayatTransaksi">
                                            <TextBlock Margin="12,0" VerticalAlignment="Center" FontSize="13" Text="{Binding Rincian}"
                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Rincian}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Nominal" Width="115" SortMemberPath="NominalBertanda">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="m:RiwayatTransaksi">
                                            <TextBlock Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding NominalText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn x:DataType="m:RiwayatTransaksi" Header="Petugas" Binding="{Binding Petugas}" Width="115" />
                                <DataGridTemplateColumn Header="Status" Width="120" SortMemberPath="IsCancelled">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="m:RiwayatTransaksi">
                                            <Border Classes="badge" Classes.danger="{Binding IsCancelled}" Margin="12,0">
                                                <TextBlock Text="{Binding StatusText}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel IsVisible="{Binding IsEmpty}" Spacing="8" Margin="0,40,0,0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource Icon.Riwayat}" Width="34" Height="34"
                                      Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Classes="muted" Text="{Binding EmptyText}" />
                        </StackPanel>
                    </Panel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
