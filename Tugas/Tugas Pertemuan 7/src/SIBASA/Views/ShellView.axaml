<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:SIBASA.Controls"
             xmlns:vm="using:SIBASA.ViewModels"
             xmlns:conv="using:SIBASA.Converters"
             x:Class="SIBASA.Views.ShellView"
             x:DataType="vm:ShellViewModel">
    <Grid ColumnDefinitions="232,*">

        <!-- ================= Sidebar navigasi ================= -->
        <Border Background="{DynamicResource SidebarBrush}">
            <DockPanel Margin="14,20,14,16">
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="6,0,0,26">
                    <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource CardGreenBrush}">
                        <PathIcon Data="{StaticResource Icon.Recycle}" Width="22" Height="22" Foreground="White" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SIBASA" FontSize="18" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="Bank Sampah Digital" FontSize="12" Foreground="{DynamicResource SidebarMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Profil pengguna dan tombol keluar -->
                <StackPanel DockPanel.Dock="Bottom" Spacing="8">
                    <Border Height="1" Background="{DynamicResource SidebarLineBrush}" Margin="0,0,0,8" />
                    <Grid ColumnDefinitions="Auto,*" Margin="6,0,0,4">
                        <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource SidebarActiveBrush}">
                            <TextBlock Text="{Binding CurrentUser.Inisial}" Foreground="White" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUser.NamaLengkap}" Foreground="White" FontWeight="SemiBold"
                                       FontSize="13" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CurrentUser.RoleText}" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="12" />
                        </StackPanel>
                    </Grid>
                    <c:SafeButton Classes="sidebar" Command="{Binding LogoutCommand}" AutomationProperties.Name="Keluar">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource Icon.Logout}" Width="18" Height="18" />
                            <TextBlock Text="Keluar" FontSize="14" />
                        </StackPanel>
                    </c:SafeButton>
                    <TextBlock Text="{Binding VersionText}" FontSize="11" Margin="6,2,0,0"
                               Foreground="{DynamicResource SidebarMutedBrush}" />
                </StackPanel>

                <!-- Menu utama (disaring sesuai peran) -->
                <StackPanel Spacing="6">
                    <TextBlock Text="MENU UTAMA" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,4"
                               LetterSpacing="1" Foreground="{DynamicResource SidebarMutedBrush}" />
                    <ListBox Classes="nav" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNavItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavItem">
                                <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent" ToolTip.Tip="{Binding Tooltip}">
                                    <PathIcon Data="{Binding IconKey, Converter={x:Static conv:AppConverters.Icon}}" Width="18" Height="18" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Shortcut}" FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Area utama ================= -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">

            <!-- Header: judul halaman, tanggal, tombol tema, peran -->
            <Panel>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="0,0,0,1" Padding="28,14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="h1" Text="{Binding CurrentPage.Title, FallbackValue=''}" />
                            <TextBlock Classes="muted" Text="{Binding CurrentPage.Subtitle, FallbackValue=''}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource Icon.Calendar}" Width="16" Height="16"
                                          Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding TodayText}" Classes="muted" VerticalAlignment="Center" />
                            </StackPanel>
                            <c:SafeButton Classes="ghost" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="{Binding ThemeToggleTooltip}"
                                    AutomationProperties.Name="Ganti tema terang/gelap">
                                <Panel>
                                    <PathIcon Data="{StaticResource Icon.Moon}" Width="18" Height="18" IsVisible="{Binding !IsDarkTheme}" />
                                    <PathIcon Data="{StaticResource Icon.Sun}" Width="18" Height="18" IsVisible="{Binding IsDarkTheme}" />
                                </Panel>
                            </c:SafeButton>
                            <Border Classes="badge info">
                                <TextBlock Text="{Binding CurrentUser.RoleText}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Indikator proses (loading) tipis di bawah header -->
                <ProgressBar Classes="thin" IsIndeterminate="True" VerticalAlignment="Bottom"
                             IsVisible="{Binding CurrentPage.IsBusy, FallbackValue=False}" />
            </Panel>

            <!-- Banner error dengan tombol "Coba lagi" -->
            <Border Grid.Row="1" Classes="banner danger" Margin="28,16,28,0"
                    IsVisible="{Binding CurrentPage.HasError, FallbackValue=False}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <PathIcon Data="{StaticResource Icon.Error}" Width="18" Height="18" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Margin="10,0" VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="{Binding CurrentPage.ErrorMessage, FallbackValue=''}" />
                    <c:SafeButton Grid.Column="2" Classes="secondary" Content="Coba lagi"
                            Command="{Binding CurrentPage.RetryCommand, FallbackValue={x:Null}}" />
                </Grid>
            </Border>

            <!-- Halaman aktif (View dipilih otomatis lewat DataTemplate) -->
            <TransitioningContentControl Grid.Row="2" Content="{Binding CurrentPage}" Margin="28,20,28,24">
                <TransitioningContentControl.PageTransition>
                    <CrossFade Duration="0:0:0.15" />
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>
        </Grid>
    </Grid>
</UserControl>
