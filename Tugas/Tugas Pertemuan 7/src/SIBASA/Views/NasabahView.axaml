<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:SIBASA.Controls"
             xmlns:vm="using:SIBASA.ViewModels"
             xmlns:m="using:SIBASA.Models"
             xmlns:conv="using:SIBASA.Converters"
             x:Class="SIBASA.Views.NasabahView"
             x:DataType="vm:NasabahViewModel">
    <Panel>
        <!-- ================= Daftar nasabah ================= -->
        <Border Classes="card" Padding="0">
            <Grid RowDefinitions="Auto,Auto,*">
                <!-- Pencarian dan filter -->
                <Grid Margin="18,18,18,10" ColumnDefinitions="*,Auto,Auto,Auto">
                    <TextBox Text="{Binding KataKunci}" Watermark="Cari nama atau no. rekening…">
                        <TextBox.InnerLeftContent>
                            <PathIcon Data="{StaticResource Icon.Search}" Width="16" Height="16" Margin="10,0,0,0"
                                      Foreground="{DynamicResource TextMutedBrush}" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <ComboBox Grid.Column="1" Width="140" Margin="10,0,0,0"
                              ItemsSource="{Binding RwOptions}" SelectedItem="{Binding SelectedRw}" />
                    <ComboBox Grid.Column="2" Width="150" Margin="10,0,0,0"
                              ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" />
                    <c:SafeButton Grid.Column="3" Classes="ghost" Margin="6,0,0,0"
                            Command="{Binding ResetFilterCommand}" ToolTip.Tip="Reset pencarian dan filter" AutomationProperties.Name="Reset pencarian dan filter">
                        <PathIcon Data="{StaticResource Icon.Filter}" />
                    </c:SafeButton>
                </Grid>

                <!-- Tombol aksi CRUD -->
                <Grid Grid.Row="1" Margin="18,0,18,14" ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:SafeButton Classes="primary" Command="{Binding TambahCommand}" AutomationProperties.Name="Tambah">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource Icon.Plus}" />
                                <TextBlock Text="Tambah" />
                            </StackPanel>
                        </c:SafeButton>
                        <c:SafeButton Classes="secondary" Command="{Binding UbahCommand}" AutomationProperties.Name="Ubah">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource Icon.Edit}" />
                                <TextBlock Text="Ubah" />
                            </StackPanel>
                        </c:SafeButton>
                        <c:SafeButton Classes="secondary" Command="{Binding ToggleStatusCommand}" AutomationProperties.Name="{Binding ToggleStatusText}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{Binding ToggleStatusIcon, Converter={x:Static conv:AppConverters.Icon}}" />
                                <TextBlock Text="{Binding ToggleStatusText}" />
                            </StackPanel>
                        </c:SafeButton>
                        <c:SafeButton Classes="dangerOutline" Command="{Binding HapusCommand}" AutomationProperties.Name="Hapus">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource Icon.Delete}" />
                                <TextBlock Text="Hapus" />
                            </StackPanel>
                        </c:SafeButton>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Classes="muted" Text="{Binding ResultText}" VerticalAlignment="Center" />
                </Grid>

                <!-- Tabel data (klik judul kolom untuk mengurutkan) -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                    <Panel>
                        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedNasabah}">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:DataType="m:Nasabah" Header="No. Rekening" Binding="{Binding NoRekening}" Width="130" />
                                <DataGridTextColumn x:DataType="m:Nasabah" Header="Nama Lengkap" Binding="{Binding NamaLengkap}" Width="*" MinWidth="150" />
                                <DataGridTextColumn x:DataType="m:Nasabah" Header="RT/RW" Binding="{Binding RtRw}" Width="95" />
                                <DataGridTextColumn x:DataType="m:Nasabah" Header="No. HP" Binding="{Binding NoHpText}" Width="135" />
                                <DataGridTextColumn x:DataType="m:Nasabah" Header="Saldo" Width="120"
                                                    Binding="{Binding Saldo, Converter={x:Static conv:AppConverters.Rupiah}}"
                                                    SortMemberPath="Saldo" />
                                <DataGridTemplateColumn Header="Status" Width="110" SortMemberPath="IsActive">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="m:Nasabah">
                                            <Border Classes="badge" Classes.success="{Binding IsActive}" Margin="12,0">
                                                <TextBlock Text="{Binding StatusText}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn x:DataType="m:Nasabah" Header="Transaksi" Binding="{Binding JumlahTransaksi}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Empty state -->
                        <StackPanel IsVisible="{Binding IsEmpty}" Spacing="8" Margin="0,40,0,0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource Icon.Empty}" Width="36" Height="36"
                                      Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Classes="muted" Text="{Binding EmptyText}" TextAlignment="Center" MaxWidth="340" />
                        </StackPanel>
                    </Panel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= Panel samping: form tambah/ubah ================= -->
        <Border Classes="drawer" IsVisible="{Binding IsFormOpen}">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid Margin="22,20,14,12" ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="h2" Text="{Binding FormTitle}" />
                        <TextBlock Classes="muted" Text="Kolom bertanda * wajib diisi" />
                    </StackPanel>
                    <c:SafeButton Grid.Column="1" Classes="ghost" VerticalAlignment="Top"
                            Command="{Binding BatalCommand}" ToolTip.Tip="Tutup" AutomationProperties.Name="Tutup">
                        <PathIcon Data="{StaticResource Icon.Close}" />
                    </c:SafeButton>
                </Grid>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14" Margin="22,0,22,10">
                        <Grid ColumnDefinitions="*,*">
                            <StackPanel>
                                <TextBlock Classes="label" Text="No. rekening" />
                                <TextBlock Text="{Binding FormNoRekening}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="label" Text="Saldo" />
                                <TextBlock Text="{Binding FormSaldoText}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessTextBrush}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel>
                            <TextBlock Classes="label" Text="Nama lengkap *" />
                            <TextBox Text="{Binding FormNamaLengkap}" Watermark="mis. Siti Aminah" MaxLength="100"
                                     Classes.invalid="{Binding NamaLengkapError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Classes="error" Text="{Binding NamaLengkapError}"
                                       IsVisible="{Binding NamaLengkapError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Classes="label" Text="No. HP" />
                            <TextBox Text="{Binding FormNoHp}" Watermark="mis. 081234567890" MaxLength="20"
                                     Classes.invalid="{Binding NoHpError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Classes="error" Text="{Binding NoHpError}"
                                       IsVisible="{Binding NoHpError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Classes="hint" Text="Opsional. 10–15 digit, diawali 08 atau +62."
                                       IsVisible="{Binding NoHpError, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,12,*">
                            <StackPanel>
                                <TextBlock Classes="label" Text="RT *" />
                                <TextBox Text="{Binding FormRt}" Watermark="mis. 03" MaxLength="3"
                                         Classes.invalid="{Binding RtError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <TextBlock Classes="error" Text="{Binding RtError}"
                                           IsVisible="{Binding RtError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="label" Text="RW *" />
                                <TextBox Text="{Binding FormRw}" Watermark="mis. 01" MaxLength="3"
                                         Classes.invalid="{Binding RwError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <TextBlock Classes="error" Text="{Binding RwError}"
                                           IsVisible="{Binding RwError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel>
                            <TextBlock Classes="label" Text="Alamat" />
                            <TextBox Classes="multiline" Text="{Binding FormAlamat}" Watermark="mis. Jl. Kenanga No. 3" MaxLength="200"
                                     Classes.invalid="{Binding AlamatError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Classes="error" Text="{Binding AlamatError}"
                                       IsVisible="{Binding AlamatError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Classes="label" Text="Status" />
                            <ToggleSwitch IsChecked="{Binding FormIsActive}" OnContent="Aktif" OffContent="Nonaktif" />
                            <TextBlock Classes="error" Text="{Binding IsActiveError}"
                                       IsVisible="{Binding IsActiveError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="22,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <c:SafeButton Classes="secondary" Content="Batal" Command="{Binding BatalCommand}" />
                        <c:SafeButton Classes="primary" Command="{Binding SimpanCommand}" AutomationProperties.Name="Simpan">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource Icon.Save}" />
                                <TextBlock Text="Simpan" />
                            </StackPanel>
                        </c:SafeButton>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Panel>
</UserControl>
