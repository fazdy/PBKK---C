<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:SIBASA.Controls"
             xmlns:vm="using:SIBASA.ViewModels"
             xmlns:m="using:SIBASA.Models"
             xmlns:conv="using:SIBASA.Converters"
             x:Class="SIBASA.Views.JenisSampahView"
             x:DataType="vm:JenisSampahViewModel">
    <Grid RowDefinitions="Auto,*">
        <!-- Info untuk Petugas: halaman ini hanya baca -->
        <Border Classes="banner info" Margin="0,0,0,14" IsVisible="{Binding IsReadOnly}">
            <Grid ColumnDefinitions="Auto,*">
                <PathIcon Data="{StaticResource Icon.Lock}" Width="16" Height="16" />
                <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="13" TextWrapping="Wrap"
                           Text="Anda masuk sebagai Petugas. Daftar harga hanya dapat dilihat; perubahan harga dilakukan oleh Admin." />
            </Grid>
        </Border>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Padding="0">
            <!-- ================= Tab Jenis Sampah ================= -->
            <TabItem AutomationProperties.Name="Jenis Sampah">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource Icon.Tag}" Width="18" Height="18" />
                        <TextBlock Text="Jenis Sampah" />
                    </StackPanel>
                </TabItem.Header>
                <Panel Margin="0,12,0,0">
                    <Border Classes="card" Padding="0">
                        <Grid RowDefinitions="Auto,*">
                            <Grid Margin="18,16,18,14" ColumnDefinitions="*,Auto,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBox Width="260" Text="{Binding KataKunciJenis}" Watermark="Cari nama jenis…">
                                        <TextBox.InnerLeftContent>
                                            <PathIcon Data="{StaticResource Icon.Search}" Width="16" Height="16" Margin="10,0,0,0"
                                                      Foreground="{DynamicResource TextMutedBrush}" />
                                        </TextBox.InnerLeftContent>
                                    </TextBox>
                                    <ComboBox Width="190" ItemsSource="{Binding KategoriFilterOptions}"
                                              SelectedItem="{Binding SelectedKategoriFilter}" />
                                    <TextBlock Classes="muted" Text="{Binding JenisResultText}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsAdmin}">
                                    <c:SafeButton Classes="primary" Command="{Binding TambahJenisCommand}" AutomationProperties.Name="Tambah">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Data="{StaticResource Icon.Plus}" />
                                            <TextBlock Text="Tambah" />
                                        </StackPanel>
                                    </c:SafeButton>
                                    <c:SafeButton Classes="secondary" Command="{Binding UbahJenisCommand}" AutomationProperties.Name="Ubah">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Data="{StaticResource Icon.Edit}" />
                                            <TextBlock Text="Ubah" />
                                        </StackPanel>
                                    </c:SafeButton>
                                    <c:SafeButton Classes="dangerOutline" Command="{Binding HapusJenisCommand}" AutomationProperties.Name="Hapus">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Data="{StaticResource Icon.Delete}" />
                                            <TextBlock Text="Hapus" />
                                        </StackPanel>
                                    </c:SafeButton>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                                <Panel>
                                    <DataGrid ItemsSource="{Binding JenisItems}" SelectedItem="{Binding SelectedJenis}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn x:DataType="m:JenisSampah" Header="Nama Jenis" Binding="{Binding NamaJenis}" Width="2*" />
                                            <DataGridTextColumn x:DataType="m:JenisSampah" Header="Kategori" Binding="{Binding NamaKategori}" Width="145" />
                                            <DataGridTextColumn x:DataType="m:JenisSampah" Header="Harga per kg" Width="140"
                                                                Binding="{Binding HargaPerKg, Converter={x:Static conv:AppConverters.Rupiah}}"
                                                                SortMemberPath="HargaPerKg" />
                                            <DataGridTemplateColumn Header="Status" Width="120" SortMemberPath="IsActive">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate x:DataType="m:JenisSampah">
                                                        <Border Classes="badge" Classes.success="{Binding IsActive}" Margin="12,0">
                                                            <TextBlock Text="{Binding StatusText}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn x:DataType="m:JenisSampah" Header="Dipakai" Binding="{Binding JumlahPemakaian}" Width="105" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel IsVisible="{Binding IsJenisEmpty}" Spacing="8" Margin="0,40,0,0"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource Icon.Empty}" Width="36" Height="36"
                                                  Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Classes="muted" Text="{Binding JenisEmptyText}" TextAlignment="Center" MaxWidth="340" />
                                    </StackPanel>
                                </Panel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Form jenis sampah (Admin) -->
                    <Border Classes="drawer" IsVisible="{Binding IsJenisFormOpen}">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid Margin="22,20,14,12" ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="h2" Text="{Binding JenisFormTitle}" />
                                    <TextBlock Classes="muted" Text="Kolom bertanda * wajib diisi" />
                                </StackPanel>
                                <c:SafeButton Grid.Column="1" Classes="ghost" VerticalAlignment="Top"
                                        Command="{Binding BatalJenisCommand}" ToolTip.Tip="Tutup" AutomationProperties.Name="Tutup">
                                    <PathIcon Data="{StaticResource Icon.Close}" />
                                </c:SafeButton>
                            </Grid>
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="14" Margin="22,0,22,10">
                                    <StackPanel>
                                        <TextBlock Classes="label" Text="Nama jenis *" />
                                        <TextBox Text="{Binding FormNamaJenis}" Watermark="mis. Botol PET Bening" MaxLength="60"
                                                 Classes.invalid="{Binding NamaJenisError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Classes="error" Text="{Binding NamaJenisError}"
                                                   IsVisible="{Binding NamaJenisError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Classes="label" Text="Kategori *" />
                                        <ComboBox ItemsSource="{Binding KategoriOptions}" SelectedItem="{Binding FormKategori}"
                                                  PlaceholderText="Pilih kategori"
                                                  Classes.invalid="{Binding KategoriError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Classes="error" Text="{Binding KategoriError}"
                                                   IsVisible="{Binding KategoriError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Classes="label" Text="Harga per kg (Rp) *" />
                                        <NumericUpDown Value="{Binding FormHarga}" Minimum="0" Maximum="1000000" Increment="100"
                                                       FormatString="N0" ParsingNumberStyle="Number" Watermark="mis. 4.000"
                                                       Classes.invalid="{Binding HargaError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Classes="error" Text="{Binding HargaError}"
                                                   IsVisible="{Binding HargaError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Classes="hint" Text="Harga baru hanya berlaku untuk setoran berikutnya; setoran lama tidak berubah." />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Classes="label" Text="Status" />
                                        <ToggleSwitch IsChecked="{Binding FormJenisAktif}" OnContent="Aktif" OffContent="Nonaktif" />
                                        <TextBlock Classes="hint" Text="Jenis nonaktif tidak muncul di pilihan setoran." />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                            <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="22,14">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                    <c:SafeButton Classes="secondary" Content="Batal" Command="{Binding BatalJenisCommand}" />
                                    <c:SafeButton Classes="primary" Command="{Binding SimpanJenisCommand}" AutomationProperties.Name="Simpan">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Data="{StaticResource Icon.Save}" />
                                            <TextBlock Text="Simpan" />
                                        </StackPanel>
                                    </c:SafeButton>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Panel>
            </TabItem>

            <!-- ================= Tab Kategori ================= -->
            <TabItem AutomationProperties.Name="Kategori">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource Icon.Kategori}" Width="18" Height="18" />
                        <TextBlock Text="Kategori" />
                    </StackPanel>
                </TabItem.Header>
                <Panel Margin="0,12,0,0">
                    <Border Classes="card" Padding="0">
                        <Grid RowDefinitions="Auto,*">
                            <Grid Margin="18,16,18,14" ColumnDefinitions="*,Auto">
                                <TextBlock Classes="muted" VerticalAlignment="Center"
                                           Text="Kategori mengelompokkan jenis sampah dan dipakai pada grafik komposisi di Dashboard." />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsAdmin}">
                                    <c:SafeButton Classes="primary" Command="{Binding TambahKategoriCommand}" AutomationProperties.Name="Tambah">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Data="{StaticResource Icon.Plus}" />
                                            <TextBlock Text="Tambah" />
                                        </StackPanel>
                                    </c:SafeButton>
                                    <c:SafeButton Classes="secondary" Command="{Binding UbahKategoriCommand}" AutomationProperties.Name="Ubah">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Data="{StaticResource Icon.Edit}" />
                                            <TextBlock Text="Ubah" />
                                        </StackPanel>
                                    </c:SafeButton>
                                    <c:SafeButton Classes="dangerOutline" Command="{Binding HapusKategoriCommand}" AutomationProperties.Name="Hapus">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Data="{StaticResource Icon.Delete}" />
                                            <TextBlock Text="Hapus" />
                                        </StackPanel>
                                    </c:SafeButton>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                                <Panel>
                                    <DataGrid ItemsSource="{Binding KategoriItems}" SelectedItem="{Binding SelectedKategori}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn x:DataType="m:KategoriSampah" Header="Nama Kategori" Binding="{Binding NamaKategori}" Width="200" />
                                            <DataGridTextColumn x:DataType="m:KategoriSampah" Header="Keterangan" Binding="{Binding KeteranganText}" Width="2*" />
                                            <DataGridTextColumn x:DataType="m:KategoriSampah" Header="Jumlah Jenis" Binding="{Binding JumlahJenis}" Width="130" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel IsVisible="{Binding IsKategoriEmpty}" Spacing="8" Margin="0,40,0,0"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource Icon.Empty}" Width="36" Height="36"
                                                  Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Classes="muted" Text="Belum ada kategori sampah." />
                                    </StackPanel>
                                </Panel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Form kategori (Admin) -->
                    <Border Classes="drawer" IsVisible="{Binding IsKategoriFormOpen}">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid Margin="22,20,14,12" ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="h2" Text="{Binding KategoriFormTitle}" />
                                    <TextBlock Classes="muted" Text="Kolom bertanda * wajib diisi" />
                                </StackPanel>
                                <c:SafeButton Grid.Column="1" Classes="ghost" VerticalAlignment="Top"
                                        Command="{Binding BatalKategoriCommand}" ToolTip.Tip="Tutup" AutomationProperties.Name="Tutup">
                                    <PathIcon Data="{StaticResource Icon.Close}" />
                                </c:SafeButton>
                            </Grid>
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="14" Margin="22,0,22,10">
                                    <StackPanel>
                                        <TextBlock Classes="label" Text="Nama kategori *" />
                                        <TextBox Text="{Binding FormNamaKategori}" Watermark="mis. Plastik" MaxLength="40"
                                                 Classes.invalid="{Binding NamaKategoriError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Classes="error" Text="{Binding NamaKategoriError}"
                                                   IsVisible="{Binding NamaKategoriError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Classes="label" Text="Keterangan" />
                                        <TextBox Classes="multiline" Text="{Binding FormKeterangan}" MaxLength="150"
                                                 Watermark="mis. Botol, gelas, dan kemasan plastik"
                                                 Classes.invalid="{Binding KeteranganError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Classes="error" Text="{Binding KeteranganError}"
                                                   IsVisible="{Binding KeteranganError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                            <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="22,14">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                    <c:SafeButton Classes="secondary" Content="Batal" Command="{Binding BatalKategoriCommand}" />
                                    <c:SafeButton Classes="primary" Command="{Binding SimpanKategoriCommand}" AutomationProperties.Name="Simpan">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Data="{StaticResource Icon.Save}" />
                                            <TextBlock Text="Simpan" />
                                        </StackPanel>
                                    </c:SafeButton>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Panel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
