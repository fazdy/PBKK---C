<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SIBASA</RootNamespace>
    <AssemblyName>SIBASA</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\sibasa.ico</ApplicationIcon>
    <!-- Binding dicek saat kompilasi (x:DataType wajib), sehingga salah ketik nama properti langsung ketahuan. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>1.0.0</Version>
    <Product>SIBASA - Sistem Informasi Bank Sampah</Product>
    <Description>Aplikasi desktop pencatatan tabungan bank sampah.</Description>
    <!-- Hanya sertakan resource bahasa Inggris dan Indonesia agar paket rilis lebih kecil. -->
    <SatelliteResourceLanguages>en;id</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Skrip SQL di folder database/ di-embed ke aplikasi dan dijalankan otomatis oleh DbInitializer. -->
    <EmbeddedResource Include="..\..\database\*.sql" LogicalName="Database.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <!-- DevTools (F12) hanya dipakai saat Debug dan tidak ikut ke build Release. -->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.22">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" Version="2.0.5" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
  </ItemGroup>

  <!--
    appsettings.json berisi connection string dan TIDAK ikut ke Git.
    Jika belum ada (misalnya setelah clone), file dibuat otomatis dari appsettings.example.json,
    lalu disalin ke folder output dan folder publish (di luar file .exe single-file).
  -->
  <Target Name="EnsureAppSettings" BeforeTargets="AssignTargetPaths">
    <Copy Condition="!Exists('$(MSBuildProjectDirectory)/appsettings.json')"
          SourceFiles="$(MSBuildProjectDirectory)/appsettings.example.json"
          DestinationFiles="$(MSBuildProjectDirectory)/appsettings.json" />
    <ItemGroup>
      <None Remove="appsettings.json" />
      <None Include="appsettings.json"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest"
            ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

</Project>
