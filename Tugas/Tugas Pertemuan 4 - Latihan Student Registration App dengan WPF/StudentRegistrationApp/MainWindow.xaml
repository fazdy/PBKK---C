<Window x:Class="StudentRegistrationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Registration App"
        Height="700"
        Width="1180"
        MinHeight="600"
        MinWidth="950"
        Background="#F1F5F9"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="370"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= FORM (KIRI) ================= -->
        <Border Grid.Column="0"
                Background="White"
                CornerRadius="10"
                Padding="20">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="STUDENT REGISTRATION"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"/>

                    <TextBlock x:Name="txtModeForm"
                               Text="Mode: Tambah Data Baru"
                               Foreground="{StaticResource NeutralBrush}"
                               Margin="0,4,0,18"/>

                    <TextBlock Text="NIM" Style="{StaticResource LabelText}"/>
                    <TextBox x:Name="txtNim" MaxLength="15"/>

                    <TextBlock Text="Nama Mahasiswa" Style="{StaticResource LabelText}"/>
                    <TextBox x:Name="txtNama" MaxLength="100"/>

                    <TextBlock Text="Program Studi" Style="{StaticResource LabelText}"/>
                    <ComboBox x:Name="cmbProdi">
                        <ComboBoxItem Content="Teknik Informatika"/>
                        <ComboBoxItem Content="Sistem Informasi"/>
                        <ComboBoxItem Content="Manajemen"/>
                        <ComboBoxItem Content="Akuntansi"/>
                    </ComboBox>

                    <TextBlock Text="Jenis Kelamin" Style="{StaticResource LabelText}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,14">
                        <RadioButton x:Name="rbLaki"
                                     Content="Laki-laki"
                                     GroupName="JenisKelamin"
                                     Margin="0,0,20,0"/>
                        <RadioButton x:Name="rbPerempuan"
                                     Content="Perempuan"
                                     GroupName="JenisKelamin"/>
                    </StackPanel>

                    <!-- Level 1: DatePicker, Alamat, No Telepon -->
                    <TextBlock Text="Tanggal Lahir" Style="{StaticResource LabelText}"/>
                    <DatePicker x:Name="dpTanggalLahir"
                                SelectedDateFormat="Long"/>

                    <TextBlock Text="Alamat" Style="{StaticResource LabelText}"/>
                    <TextBox x:Name="txtAlamat"
                             Height="60"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalContentAlignment="Top"
                             Padding="6,4"
                             MaxLength="200"/>

                    <TextBlock Text="No. Telepon" Style="{StaticResource LabelText}"/>
                    <TextBox x:Name="txtTelepon" MaxLength="15"/>

                    <!-- Tombol aksi -->
                    <UniformGrid Columns="2" Margin="0,8,0,0">
                        <Button x:Name="btnSimpan"
                                Content="Simpan"
                                Style="{StaticResource ActionButton}"
                                Background="{StaticResource SuccessBrush}"
                                Margin="0,0,5,8"
                                Click="BtnSimpan_Click"/>
                        <Button x:Name="btnUpdate"
                                Content="Update"
                                Style="{StaticResource ActionButton}"
                                Background="{StaticResource WarningBrush}"
                                Margin="5,0,0,8"
                                IsEnabled="False"
                                Click="BtnUpdate_Click"/>
                        <Button x:Name="btnReset"
                                Content="Reset"
                                Style="{StaticResource ActionButton}"
                                Background="{StaticResource NeutralBrush}"
                                Margin="0,0,5,0"
                                Click="BtnReset_Click"/>
                        <Button x:Name="btnHapus"
                                Content="Hapus"
                                Style="{StaticResource ActionButton}"
                                Background="{StaticResource DangerBrush}"
                                Margin="5,0,0,0"
                                Click="BtnHapus_Click"/>
                    </UniformGrid>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================= DATA (KANAN) ================= -->
        <Border Grid.Column="2"
                Background="White"
                CornerRadius="10"
                Padding="20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="DATA MAHASISWA"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           Margin="0,0,0,14"/>

                <!-- Level 2: Search -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Cari (NIM / Nama / Prodi):"
                               Style="{StaticResource LabelText}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBox x:Name="txtCari"
                             Grid.Column="1"
                             Margin="0"
                             TextChanged="TxtCari_TextChanged"/>
                </Grid>

                <!-- Tampilan data (pengembangan dari ListBox menjadi DataGrid) -->
                <DataGrid x:Name="dgMahasiswa"
                          Grid.Row="2"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F8FAFC"
                          RowHeight="30"
                          SelectionChanged="DgMahasiswa_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NIM" Binding="{Binding Nim}" Width="100"/>
                        <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="*"/>
                        <DataGridTextColumn Header="Program Studi" Binding="{Binding Prodi}" Width="130"/>
                        <DataGridTextColumn Header="L/P" Binding="{Binding JenisKelamin}" Width="80"/>
                        <DataGridTextColumn Header="Tgl Lahir"
                                            Binding="{Binding TanggalLahir, StringFormat=dd-MM-yyyy}"
                                            Width="90"/>
                        <DataGridTextColumn Header="Alamat" Binding="{Binding Alamat}" Width="*"/>
                        <DataGridTextColumn Header="No. Telepon" Binding="{Binding NoTelepon}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Level 2: Counter -->
                <TextBlock x:Name="txtJumlah"
                           Grid.Row="3"
                           Text="Jumlah Mahasiswa: 0"
                           FontWeight="SemiBold"
                           Margin="0,12,0,0"/>
            </Grid>
        </Border>

    </Grid>
</Window>
